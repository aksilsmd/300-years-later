{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/Library/Keychains/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(git push --force*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(git push*)",
      "Bash(gh repo create*)",
      "Bash(gh release*)",
      "Bash(steamcmd*)",
      "Bash(npm publish*)",
      "Bash(git lfs push*)"
    ],
    "allow": [
      "Bash(python3 tools/*)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npx remotion *)",
      "Bash(robot *)",
      "Bash(k6 run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git lfs *)",
      "mcp__unreal*"
    ]
  },
  "enabledPlugins": {
    "unreal-engine-skills-for-claude-code@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}