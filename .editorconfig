# EN — Shared editor settings so contributors' tools agree. https://editorconfig.org
# FR — Réglages d'éditeur partagés, pour que les outils des contributeurs s'accordent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,ps1}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # two trailing spaces are a hard line break in Markdown

[Makefile]
indent_style = tab
