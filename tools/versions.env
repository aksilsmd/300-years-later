# Versions épinglées — source unique pour les scripts d'installation et la CI.
# Mettez-les à jour volontairement (PR dédiée), jamais automatiquement.

UE_VERSION="5.8"               # Unreal Engine — installé via Epic Games Launcher (compte Epic de l'humain)
VS_VERSION="2022"              # Visual Studio Community/Professional (charges C++ jeux + bureau)
DOTNET_MAJOR="8"               # requis par UnrealBuildTool
PYTHON_MIN="3.11"
NODE_MAJOR="22"                # LTS — landing page et Remotion
BLENDER_SERIES="4.5"           # LTS — retouches d'assets
BLENDER_VERSION="4.5.3"        # vérifier le dernier correctif de la série
ROBOT_SPEC="robotframework robotframework-browser"
SEMGREP_SPEC="semgrep"
K6_VERSION="2.3.0"             # pinned / épinglé — mettre à jour par PR dédiée
GITLEAKS_VERSION="8.30.1"      # pinned / épinglé — doit rester identique au tag du conteneur dans .github/workflows/security.yml
CLAUDE_UE_PLUGIN="unreal-engine-skills-for-claude-code@claude-plugins-official"

# Domaines autorisés pour les téléchargements des scripts d'installation
ALLOWED_DOWNLOAD_HOSTS="github.com objects.githubusercontent.com download.blender.org nodejs.org pypi.org files.pythonhosted.org registry.npmjs.org dl.k6.io"
